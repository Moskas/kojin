  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.tsx",
    "build": "bun build --compile --target=bun src/server.tsx --outfile kojin",
    "start": "bun run src/server.tsx",
    "lint": "tsc --noEmit",
    "format": "treefmt"
  },
  "dependencies": {
